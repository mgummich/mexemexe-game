# Sample environment for docker-compose.traefik.yml.
# Copy to .env (git-ignored) and fill in real values:
#
#   cp .env.example .env && chmod 600 .env
#
# The plain docker-compose.yml needs none of this except MEXE_METRICS_TOKEN.

# --- Traefik / TLS (docker-compose.traefik.yml only) ---

# Public hostname the game is served on. Pick a random, unlisted subdomain:
# the test build has no login, so the hostname is the only thing keeping it private.
MEXE_HOST=k3f9x2.example.com

# Apex zone the wildcard certificate is issued for (*.MEXE_DOMAIN).
MEXE_DOMAIN=example.com

# Contact address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=admin@example.com

# Cloudflare API token for the DNS-01 challenge. Scope it to Zone:DNS:Edit on
# this one zone only — it can rewrite the zone's records.
CLOUDFLARE_DNS_API_TOKEN=

# --- Client build ---

# WebSocket URL baked into the bundle at build time. Leave empty behind the
# Traefik stack: over HTTPS the client defaults to wss://<host>/ws, which is
# exactly what the mexe-ws router serves. Set it only when the WebSocket server
# lives on a different host or path, e.g. wss://ws.example.com.
VITE_WS_URL=

# --- Metrics (optional) ---

# Bearer token for /metrics. Unset leaves the endpoint returning 404 in
# production. Needs >= 16 chars; required by the `monitoring` profile.
#   openssl rand -hex 24
MEXE_METRICS_TOKEN=

# --- Abuse controls ---

# REQUIRED. Browser origins allowed to open a game WebSocket, comma-separated —
# your own site's origin(s), so a page on any other site cannot open sockets here.
# Use `*` to accept any origin, which is the right answer only when the server is
# reached through someone else's proxy or by non-browser clients. The server
# refuses to start in production rather than let an omission pass for a decision.
#   MEXE_ALLOWED_ORIGINS=https://mexe.example,https://www.mexe.example
MEXE_ALLOWED_ORIGINS=*

# Rooms one client address may create per minute (default 20).
MEXE_MAX_ROOM_CREATES_PER_IP=

# Reverse proxies in front of the WebSocket server. 0 (the default) ignores
# X-Forwarded-For entirely and keys the per-address limits on the socket's own
# peer address; the Traefik compose files default this to 1. Only raise it when
# the server's port is unreachable except through those proxies — a client that
# can connect directly can put whatever it likes in the header.
MEXE_TRUSTED_PROXY_HOPS=

# --- Released images (docker-compose.traefik.prod.yml only) ---

# Release tag to pull from ghcr.io. Pin an explicit version rather than `latest`,
# so a redeploy can never pull a different build than the one you tested.
MEXE_VERSION=v1.10.0

# --- Existing Traefik (docker-compose.prod.yml only) ---

# Name of the external docker network your running Traefik is attached to.
# Find it with: docker network ls
TRAEFIK_NETWORK=proxy

# HTTPS entrypoint name in your Traefik config. Default `websecure`.
TRAEFIK_ENTRYPOINT=websecure

# Certificate resolver name in your Traefik config. Default `le`. If your Traefik
# loads a wildcard certificate some other way, drop the tls.certresolver labels
# from docker-compose.prod.yml instead of setting this.
TRAEFIK_CERTRESOLVER=le
